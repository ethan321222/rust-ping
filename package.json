{
  "name": "rust-ping",
  "version": "1.0.0",
  "description": "High-performance ICMP ping for Node.js/Bun — single-socket concurrent ping, zero child processes, powered by Rust napi-rs",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "binding.js",
    "binding.d.ts"
  ],
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.js",
      "types": "./index.d.ts"
    }
  },
  "napi": {
    "name": "ping",
    "triples": {
      "defaults": true
    }
  },
  "scripts": {
    "build": "napi build --platform --release --js binding.js --dts binding.d.ts --cargo-cwd crates/ping-napi",
    "build:debug": "napi build --platform --js binding.js --dts binding.d.ts --cargo-cwd crates/ping-napi",
    "test": "node __test__/ping.test.js",
    "test:esm": "node __test__/ping.test.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "optionalDependencies": {
    "rust-ping-win32-x64-msvc": "1.0.0",
    "rust-ping-darwin-x64": "1.0.0",
    "rust-ping-darwin-arm64": "1.0.0",
    "rust-ping-linux-x64-gnu": "1.0.0",
    "rust-ping-linux-x64-musl": "1.0.0",
    "rust-ping-linux-arm64-gnu": "1.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "ethan321222",
    "url": "https://github.com/ethan321222"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ethan321222/rust-ping.git"
  },
  "homepage": "https://github.com/ethan321222/rust-ping#readme",
  "bugs": {
    "url": "https://github.com/ethan321222/rust-ping/issues"
  },
  "keywords": ["ping", "icmp", "network", "rust", "napi", "native", "node", "bun", "net-ping"]
}